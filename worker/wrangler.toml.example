name = "ymonitor-api"
main = "src/index.ts"
compatibility_date = "2026-09-01"

# Локальная копия (worker/wrangler.toml) не коммитится — в ней реальный
# database_id. Создание:
#   cp wrangler.toml.example wrangler.toml
#   npx wrangler d1 create public-peers
# и вписать возвращённый database_id.
#
# ВАЖНО: binding должен называться PUBLIC_PEERS — на это имя рассчитан код.
[[d1_databases]]
binding = "PUBLIC_PEERS"
database_name = "public-peers"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
